0	"def evaluate_predictions(y_true, y_pred, y_prob, meta, arcs_by_trip):\n"
1	"    obs_ids = meta['obs_ids']\n"
2	"    trip_ids = meta['trip_ids']\n"
3	"    cand_arcs = meta['cand_arcs']\n"
4	"\n"
5	"    obs_starts = np.flatnonzero(np.r_[True, obs_ids[1:] != obs_ids[:-1]])\n"
6	"    obs_ends = np.r_[obs_starts[1:], len(obs_ids)]\n"
7	"\n"
8	"    top1_hits = 0\n"
9	"    misses = 0\n"
10	"    pred_seqs = {}\n"
11	"    for s, e in zip(obs_starts, obs_ends):\n"
12	"        best_i = s + int(np.argmax(y_prob[s:e]))\n"
13	"        if y_true[best_i] == 1:\n"
14	"            top1_hits += 1\n"
15	"        if np.max(y_true[s:e]) == 0:\n"
16	"            misses += 1\n"
17	"        tid = int(trip_ids[s])\n"
18	"        pred_seqs.setdefault(tid, []).append(int(cand_arcs[best_i]))\n"
19	"\n"
20	"    cont_hits = 0\n"
21	"    cont_total = 0\n"
22	"    for tid, seq in pred_seqs.items():\n"
23	"        arcs = arcs_by_trip[tid]\n"
24	"        for a1, a2 in zip(seq[:-1], seq[1:]):\n"
25	"            cont_total += 1\n"
26	"            if a1 == a2 or arcs[a1, 1] == arcs[a2, 0]:\n"
27	"                cont_hits += 1\n"
28	"\n"
29	"    return {\n"
30	"        'candidate_acc': accuracy_score(y_true, y_pred),\n"
31	"        'precision': precision_score(y_true, y_pred, zero_division=0),\n"
32	"        'recall': recall_score(y_true, y_pred, zero_division=0),\n"
33	"        'macro_f1': f1_score(y_true, y_pred, average='macro'),\n"
34	"        'log_loss': log_loss(y_true, y_prob, labels=[0, 1]),\n"
35	"        'top1_acc': top1_hits / len(obs_starts),\n"
36	"        'miss_rate': misses / len(obs_starts),\n"
37	"        'route_continuity': cont_hits / max(cont_total, 1)\n"
38	"    }"
