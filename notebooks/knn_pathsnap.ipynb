0	"USE_GPU = False\n"
1	"try:\n"
2	"    from cuml.neighbors import KNeighborsClassifier as cuKNeighborsClassifier\n"
3	"    _probe = cuKNeighborsClassifier(n_neighbors=3, weights='distance')\n"
4	"    _probe.fit(np.zeros((6, 2), dtype=np.float32), np.array([0, 1, 0, 1, 0, 1]))\n"
5	"    USE_GPU = True\n"
6	"except Exception:\n"
7	"    USE_GPU = False\n"
8	"\n"
9	"def to_numpy(arr):\n"
10	"    if hasattr(arr, 'to_numpy'):\n"
11	"        return arr.to_numpy()\n"
12	"    if hasattr(arr, 'get'):\n"
13	"        return arr.get()\n"
14	"    return np.asarray(arr)\n"
15	"\n"
16	"def make_knn(n_neighbors):\n"
17	"    if USE_GPU:\n"
18	"        return cuKNeighborsClassifier(n_neighbors=n_neighbors, weights='distance')\n"
19	"    return KNeighborsClassifier(n_neighbors=n_neighbors, weights='distance', algorithm='kd_tree', leaf_size=40, n_jobs=-1)\n"
20	"\n"
21	"print('Backend:', 'GPU (cuML)' if USE_GPU else 'CPU (scikit-learn KDTree)')"
