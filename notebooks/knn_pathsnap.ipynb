0	"{'n_neighbors': 7, 'cv_top1_acc': 0.6729, 'cv_macro_f1': 0.737, 'cv_log_loss': 1.6898, 'cv_time_s': 227.82}\n"
1	"{'n_neighbors': 15, 'cv_top1_acc': 0.679, 'cv_macro_f1': 0.7465, 'cv_log_loss': 0.9727, 'cv_time_s': 296.25}\n"
2	"{'n_neighbors': 25, 'cv_top1_acc': 0.6824, 'cv_macro_f1': 0.7496, 'cv_log_loss': 0.7383, 'cv_time_s': 319.38}\n"
3	"Selected n_neighbors: 25\n"
source	
0	"gkf = GroupKFold(n_splits=5)\n"
1	"train_groups = train_meta['trip_ids']\n"
2	"k_grid = [7, 15, 25]\n"
3	"cv_results = []\n"
4	"\n"
5	"for k_val in k_grid:\n"
6	"    fold_f1, fold_loss, fold_top1 = [], [], []\n"
7	"    t_cv = time.time()\n"
8	"    for tr_idx, va_idx in gkf.split(X_train, y_train, train_groups):\n"
9	"        scaler_cv = StandardScaler()\n"
10	"        X_tr = scaler_cv.fit_transform(X_train[tr_idx]).astype(np.float32)\n"
11	"        X_va = scaler_cv.transform(X_train[va_idx]).astype(np.float32)\n"
12	"        model_cv = make_knn(k_val)\n"
13	"        model_cv.fit(X_tr, y_train[tr_idx])\n"
14	"        proba_va = to_numpy(model_cv.predict_proba(X_va))\n"
15	"        prob_va = proba_va[:, 1]\n"
16	"        pred_va = np.argmax(proba_va, axis=1)\n"
17	"\n"
18	"        va_meta = {\n"
19	"            'obs_ids': train_meta['obs_ids'][va_idx],\n"
20	"            'trip_ids': train_meta['trip_ids'][va_idx],\n"
21	"            'cand_arcs': train_meta['cand_arcs'][va_idx]\n"
22	"        }\n"
23	"        m_va = evaluate_predictions(y_train[va_idx], pred_va, prob_va, va_meta, train_arcs)\n"
24	"        fold_f1.append(m_va['macro_f1'])\n"
25	"        fold_loss.append(m_va['log_loss'])\n"
26	"        fold_top1.append(m_va['top1_acc'])\n"
27	"\n"
28	"    row = {\n"
29	"        'n_neighbors': k_val,\n"
30	"        'cv_top1_acc': round(float(np.mean(fold_top1)), 4),\n"
31	"        'cv_macro_f1': round(float(np.mean(fold_f1)), 4),\n"
32	"        'cv_log_loss': round(float(np.mean(fold_loss)), 4),\n"
33	"        'cv_time_s': round(time.time() - t_cv, 2)\n"
34	"    }\n"
35	"    cv_results.append(row)\n"
36	"    print(row)\n"
37	"\n"
38	"cv_df = pd.DataFrame(cv_results)\n"
39	"best_k = int(cv_df.loc[cv_df['cv_top1_acc'].idxmax(), 'n_neighbors'])\n"
40	"print('Selected n_neighbors:', best_k)"
